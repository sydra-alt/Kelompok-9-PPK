# ============================================================================
# Konfigurasi Environment Aplikasi Presensi Praktikum (Sprint 2)
# ============================================================================
# Salin berkas ini menjadi `.env` di root proyek:
#   cp .env.example .env
# Lalu isi nilai sesuai project Firebase & API AI dari pengajar.
# Berkas `.env` sudah di-ignore oleh git — JANGAN commit kredensial asli.
# ============================================================================

# --- Firebase Client Web Config (Wajib) ---
# Diperoleh dari Firebase Console -> Project Settings -> General -> Your apps (Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- API AI Klasifikasi Alasan Izin (Opsional / sesuai informasi pengajar) ---
# Jika dikosongkan, pengajuan izin tetap tersimpan dengan aiClassification.status = "skipped".
EXPO_PUBLIC_AI_CLASSIFIER_URL=
EXPO_PUBLIC_AI_CLASSIFIER_API_KEY=
EXPO_PUBLIC_AI_CLASSIFIER_TIMEOUT_MS=10000

